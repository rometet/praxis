# Praxis Client repository allow-list.
#
# Keep the public repository focused on source code, documentation, and
# the exact assets required to build it. Exclude local reference material,
# downloaded tools, build trees, runtime data, and generated binaries.
/*
!/.gitignore
!/.gitattributes
!/CMakeLists.txt
!/CMakePresets.json
!/README.md
!/LICENSE
!/LICENSE.*
!/CHANGELOG
!/CHANGELOG.*
!/CONTRIBUTING.md
!/SECURITY.md
!/xmake.lua
!/manifest.json
!/config.example.json
!/RELEASE_POLICY.md
!/CHANGELOG.md
!/tools/
!/tools/**
!/licenses/
!/licenses/**
!/THIRD_PARTY_NOTICES.md
!/fix_sdk.py
!/.github/
!/.github/**
!/cmake/
!/cmake/**
!/docs/
!/docs/**
!/mappings/
!/mappings/**
!/src/
!/src/**
!/tests/
!/tests/**

# Current audited Companion layout and portable build instructions.
!/SOURCE_BUILD.md
!/companion/
/companion/*
!/companion/LICENSE
!/companion/LICENSE_COMBINED.txt
!/companion/README.md
!/companion/config.example.json
!/companion/manifest.json
!/companion/xmake.lua
!/companion/src/
!/companion/src/**
!/companion/tests/
!/companion/tests/**
!/companion/tools/
/companion/tools/*
!/companion/tools/audit_map_boundaries.py
!/companion/tools/convert_ui_render.py
!/companion/tools/run_approved_lifecycle_regressions.py
!/companion/tools/verify_runtime_package.py

# Heavy/generated files under the included trees.
**/build/
**/build-*/
**/_deps/
**/.codegraph/
**/.git/
**/node_modules/
**/__pycache__/
**/*.pyc
**/dist/
**/*.log
**/*.zip
**/*.tar.gz
**/*.tgz
**/*.jar
**/*.dll
**/*.exe
**/*.pdb
**/*.obj
**/*.lib
**/*.ilk
**/*.exp
**/*.d
**/*.tmp
**/*.bak
**/*.orig

# CMake/IDE user state.
**/CMakeCache.txt
**/CMakeFiles/
**/.vs/
**/.vscode/
**/.idea/
**/*.user
**/*.suo
**/compile_commands.json
